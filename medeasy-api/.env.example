APP_NAME="MedEasy API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local dev default: sqlite (zero setup). Switch to pgsql for Heroku.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=medeasy
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Sanctum: domains allowed to use cookie-based auth (not used by our
# token-based API auth, but Sanctum still needs this config present).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# CORS: comma-separated list of frontend origins allowed to call this API.
FRONTEND_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible) for local content file storage
FILESYSTEM_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# Google Gemini API (used in a later phase for AI summaries/quizzes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
